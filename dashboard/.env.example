# Backend the dashboard proxies to. Read at request time (no rebuild needed).
# Local backend:
API_URL=http://localhost:8000
# Production VPS:
# API_URL=http://51.170.132.143:8000

# Optional: forwarded to the backend as X-API-Key if the API ever requires one.
# API_KEY=

# Legacy name from the first handover; still honoured as the proxy target.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Only set this if you want the browser to call the backend directly and skip the
# proxy (requires CORS on the backend and an HTTPS backend when the site is HTTPS).
# NEXT_PUBLIC_API_DIRECT_URL=
