# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# DynamoDB Tables
DDB_VOLUNTEERS_TABLE=vshift-volunteers
DDB_SHIFTS_TABLE=vshift-shifts
DDB_COMMUNICATIONS_TABLE=vshift-communications
DDB_REPORTS_TABLE=vshift-reports
DDB_AUDIT_TABLE=vshift-audit

# S3 Buckets
S3_REPORTS_BUCKET=vshift-reports
S3_AUDIT_BUCKET=vshift-audit
S3_SESSIONS_BUCKET=vshift-sessions

# SES
SES_SOURCE_EMAIL=coordinator@vshift.example.org

# SNS
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:000000000000:vshift-sms

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# No-show detection threshold in minutes (15 for prod, 2 for demo)
NOSHOW_THRESHOLD_MINUTES=2
