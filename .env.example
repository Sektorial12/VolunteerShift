# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock (Mantle API with bearer token)
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct

# DynamoDB Tables
DDB_VOLUNTEERS_TABLE=vshift-volunteers
DDB_SHIFTS_TABLE=vshift-shifts
DDB_COMMUNICATIONS_TABLE=vshift-communications
DDB_REPORTS_TABLE=vshift-reports
DDB_AUDIT_TABLE=vshift-audit

# S3 Buckets
S3_REPORTS_BUCKET=vshift-reports
S3_AUDIT_BUCKET=vshift-audit
S3_SESSIONS_BUCKET=vshift-sessions

# SES
SES_SOURCE_EMAIL=coordinator@vshift.example.org

# SNS
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:vshift-sms

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# No-show detection threshold in minutes (15 for prod, 2 for demo)
NOSHOW_THRESHOLD_MINUTES=2

# Automation scheduler
# AUTOMATION_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=30
# TIME_ACCELERATION=1.0  # >1 compresses time for demo (e.g. 60x)

# CORS origins (comma-separated) for the dashboard / partner frontends
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability (StrandsTelemetry / OpenTelemetry)
# TELEMETRY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-endpoint.example
